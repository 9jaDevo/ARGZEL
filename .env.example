# Copy to .env.local for local development (it is git-ignored). Never commit real values.
# On Render, set the same keys under Environment.

# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster. Optional, defaults to "argzel".
MONGODB_DB=argzel

# Signs the session cookie. At least 32 characters; changing it signs everyone out.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Gemma (reminder parsing) via the Gemini API. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default gemma-4-26b-a4b-it (fast); gemma-4-31b-it is the larger option.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Whisper (speech-to-text) via an OpenAI-compatible endpoint. Default: Groq. Free key: https://console.groq.com/keys
STT_API_KEY=
# Optional overrides, e.g. a self-hosted faster-whisper server (which may need no key).
STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
STT_MODEL=whisper-large-v3-turbo

# Email delivery via Resend. Key: https://resend.com/api-keys
RESEND_API_KEY=
# Sender. The default test sender can only email your own Resend account address;
# verify a domain in Resend to email any user, e.g. "ARGZEL <reminders@yourdomain.tech>".
EMAIL_FROM=ARGZEL <onboarding@resend.dev>
# Public app URL, used for the "Open ARGZEL" link in emails.
APP_URL=http://localhost:3000
# Shared secret for the every-minute cron call to /api/cron/dispatch (at least 16 characters).
CRON_SECRET=
